# Copy to .env for local development. Under Cloudflare these come from the Secrets Store.
PORT=3000
APP_BASE_URL=http://localhost:3000
DB_PATH=data/app.db

# opencode go inference provider (OpenAI-compatible chat completions)
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=
